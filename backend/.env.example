# Base de datos PostgreSQL
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

# Secreto para firmar JWT (usar un valor largo y aleatorio, no reutilizar entre entornos)
JWT_SECRET=

# Origen permitido para CORS (URL del frontend)
FRONTEND_URL=http://localhost:5173

# "production" en el servidor institucional (activa trust proxy, etc.)
# Vacío o sin definir en desarrollo local.
NODE_ENV=